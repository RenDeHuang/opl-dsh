{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/suite/host.ts",
    "src/*/host/**/*.ts",
    "src/*/contracts/**/*.ts",
    "src/contracts/**/*.ts",
    "src/shared/models.ts"
  ]
}
